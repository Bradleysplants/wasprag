# Copy to .env.server (used by `wasp start`). Never commit .env.server.
# Postgres needs the pgvector extension (schema.prisma uses vector(384)).
# `wasp start db` provisions a dev Postgres and sets DATABASE_URL for you;
# only set it yourself when pointing at your own database.
DATABASE_URL=postgresql://user:password@localhost:5432/botanibuddy
JWT_SECRET=changeme-at-least-32-chars

# URLs
WASP_WEB_CLIENT_URL=http://localhost:3000
WASP_SERVER_URL=http://localhost:3001
CLIENT_URL=http://localhost:3000

# LLM (LLM_PROVIDER: ollama | openai)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=60000
MODEL_NAME=
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=1024
OPENAI_API_KEY=
OPENAI_MODEL_NAME=
GGUF_MODEL_PATH=
GGUF_MODEL_FILE_NAME=

# Embeddings (Hugging Face)
HF_TOKEN=
HUGGINGFACE_API_KEY=
# Must output 384 dims to match vector(384) in schema.prisma
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Plant data APIs
PERENUAL_API_KEY=
TREFLE_API_KEY=

# Strapi CMS (../WaspClient)
STRAPI_API_URL=http://localhost:1337
STRAPI_API_TOKEN=

# Email (Resend)
RESEND_API_KEY=
RESEND_DEFAULT_FROM_EMAIL=

# RAG
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# PayPal (sandbox or live credentials; PAYPAL_MODE: sandbox | live)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASIC_PLAN_ID=
PAYPAL_PREMIUM_PLAN_ID=
PAYPAL_PROFESSIONAL_PLAN_ID=
